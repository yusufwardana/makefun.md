# Copy to .env for local configuration. Keep real secrets outside version control.
# Optional token for API mutations and Muse downloads.
COMMAND_CENTER_TOKEN=""

# Defaults to loopback. Use an authenticated reverse proxy if hosted remotely.
HOST="127.0.0.1"
PORT="3000"
APP_URL="http://localhost:3000"

# Optional SQLite path. Defaults to ./data/cosmiclabs.db.
# COSMICLABS_DB_PATH="./data/cosmiclabs.db"
